# Copy to .env.local for local development. Deployments set these in the
# Vercel project. `vercel env pull` fills in the connector UIDs and the
# OIDC token for you.

# --- Required ---------------------------------------------------------------

# The repository the factory works on, as owner/repo. The GitHub App behind
# the connector must be installed with access to it.
FACTORY_REPO=acme/widgets

# Vercel Connect connector UIDs. Set automatically when the connectors are
# added to the project.
GITHUB_CONNECTOR=github/foreman-agent
LINEAR_CONNECTOR=linear/foreman-agent

# --- Optional: how the factory works ----------------------------------------

# Runs once per session inside each station's checkout, with no GitHub
# credential and with install scripts off.
# FACTORY_SETUP_COMMAND=pnpm install

# The issue label that hands an issue to the factory. Default: factory
# FACTORY_LABEL=factory

# Prefix of the factory's own branches, the only ones it pushes to.
# Default: factory/
# FACTORY_BRANCH_PREFIX=factory/

# The @mention name. Default: the GitHub App's slug, from the connector.
# FACTORY_BOT_NAME=

# --- Optional: HTTP intake API ----------------------------------------------

# Shared secret (32 characters or more) for POST /intake/v1/tickets. Unset,
# only callers with a Vercel OIDC token for the project can submit.
# FACTORY_INTAKE_TOKEN=

# Comma-separated hosts (host or host:port, exact match) a ticket's
# callbackUrl may point at.
# FACTORY_INTAKE_CALLBACK_HOSTS=

# Signs status callbacks. Without it no callbacks are sent.
# FACTORY_INTAKE_CALLBACK_SECRET=

# --- Optional: GitHub tokens ------------------------------------------------

# What happens when GitHub refuses a narrowed, per-command token.
# none (default): the command fails. repository: use a token with every
# permission the app holds, on FACTORY_REPO only. installation: that, then
# the connector's full installation token.
# FACTORY_TOKEN_FALLBACK=none

# Set to 1 to let the implementer's push change .github/workflows.
# FACTORY_ALLOW_WORKFLOW_CHANGES=1

# Set to 1 if a ruleset requires signed commits on the factory's branches.
# Git LFS files cannot be pushed this way.
# FACTORY_SIGNED_COMMITS=1

# --- Optional: sandbox ------------------------------------------------------

# Unset, the sandboxes that hold your code reach GitHub and the public
# package registries only. Set to open to allow every host.
# FACTORY_SANDBOX_EGRESS=open

# Comma-separated hostnames to allow on top of the defaults. Full hostnames
# only: no scheme, port, path, or wildcard.
# FACTORY_SANDBOX_ALLOWED_DOMAINS=npm.example.com,api.example.com

# Set to 1 to let package managers run install scripts in station sandboxes.
# FACTORY_ALLOW_INSTALL_SCRIPTS=1
