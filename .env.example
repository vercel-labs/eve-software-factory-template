# Vercel Connect connector UIDs. The deploy button provisions and sets both;
# for manual setup, create them with `vercel connect create` and paste the UIDs.
GITHUB_CONNECTOR=github/foreman-agent
LINEAR_CONNECTOR=linear/foreman-agent

# The repository the factory works on. Must be an existing GitHub repository
# in owner/repo format, and the GitHub App behind GITHUB_CONNECTOR must be
# installed with access to it: a station sandbox clones this repository on its
# first session and fails with "Cannot access <owner/repo>" when the app
# cannot reach it. A missing or malformed value fails discovery with a clear
# error.
FACTORY_REPO=acme/widgets

# Optional: runs inside the station sandbox's clone once per session, so a
# session starts with dependencies installed and the repo's checks runnable.
# FACTORY_SETUP_COMMAND="pnpm install"

# Optional overrides; every one has a sensible default.
# FACTORY_LABEL="factory"            # the label that hands an issue to the factory
# FACTORY_BRANCH_PREFIX="factory/"   # prefix of the factory's own branches, the only ones it pushes to (never main or master)
# FACTORY_BOT_NAME=""                # @mention name; defaults to the GitHub App's own slug via the connector

# Optional: the HTTP intake API (POST /intake/v1/tickets). FACTORY_INTAKE_TOKEN
# is the shared secret callers send as a Bearer token and must be at least 32
# characters (for example, the output of `openssl rand -hex 32`). When it is
# unset, only callers holding a Vercel OIDC token for this project can submit.
# FACTORY_INTAKE_TOKEN=""
# FACTORY_INTAKE_CALLBACK_HOSTS=""    # comma-separated hosts (host or host:port, exact match) a ticket's callbackUrl may point at
# FACTORY_INTAKE_CALLBACK_SECRET=""   # signs status callbacks (x-factory-signature); without it a ticket with a callbackUrl is refused

# Optional: what happens when GitHub refuses a narrowed, per-command token.
# Unset or "none" fails the command. "repository" allows the app's full
# permissions on FACTORY_REPO; "installation" also allows the connector's
# plain installation token (every repository the app is installed on). A
# command a station runs in its shell never gets a wider token: when no
# read-only token can be issued, a station's read must be a whole command (gh
# reads joined with &&, or one git fetch), not part of a pipe.
# FACTORY_TOKEN_FALLBACK="none"

# Optional: set to 1 to let the implementer's push change .github/workflows
# (adds Workflows write to the push token). Unset, GitHub rejects such a push.
# FACTORY_ALLOW_WORKFLOW_CHANGES=1

# Memory storage needs nothing filled in by hand: `eve integration setup
# file-memory` provisions a private Blob store for preferences and the factory
# brain and sets EVE_MEMORY_BLOB_STORE_ID on the project. `eve dev` keeps
# memory in the local process instead.
