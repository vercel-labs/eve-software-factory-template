    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "~24.19.0",
    "typescript": "7.0.2",
    "ultracite": "^7.12.1",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": "24.x"
  }
}
