{
  "name": "eve-software-factory-template",
  "version": "0.0.0",
  "private": true,
  "description": "Foreman, the eve Software Factory.",
  "license": "MIT",
  "type": "module",
  "imports": {
    "#*": "./agent/*",
    "#evals/*": "./evals/*"
  },
  "scripts": {
    "build": "eve build",
    "check": "ultracite check",
    "dev": "eve dev",
    "discovery": "node scripts/check-discovery.ts",
    "eval": "eve eval",
    "fix": "ultracite fix",
    "start": "eve start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc",
    "validate": "pnpm run check && pnpm run typecheck && pnpm run test && pnpm run discovery"
  },
  "dependencies": {
    "@vercel/blob": "^2.9.0",
    "@vercel/connect": "^2.9.3",
    "ai": "^7.0.173",
